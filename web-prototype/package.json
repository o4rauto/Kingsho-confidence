{
  "name": "bastion-rush",
  "version": "0.1.0",
  "description": "Bastion Rush — a last-stand roguelite tower-brawler. Kingdom Rush x Clash Royale x Archero.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "cap:sync": "cap sync android",
    "android:build": "npm run build && cap sync android && cd android && ./gradlew bundleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
